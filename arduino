#define RELAY_PIN D1
#define CHECK_PIN D3                   // pin zwrotny — NO + GND
#define WATCHDOG_TIMEOUT_MS 5000       // 5s bez komendy → auto HIPOT

String command    = "";
String relayState = "HIPOT";
unsigned long lastCmdTime = 0;
bool watchdogEnabled = false;

void setRelay(String state) {
  if (state == "PE") {
    digitalWrite(RELAY_PIN, HIGH);
    relayState = "PE";
  } else {
    digitalWrite(RELAY_PIN, LOW);
    relayState = "HIPOT";
  }
}

bool verifyRelay(String expectedState) {
  delay(100);  // chwila na mechaniczne przełączenie
  int pinVal = digitalRead(CHECK_PIN);
  if (expectedState == "PE")    return pinVal == LOW;   // NO zamknięty → GND zwarte → LOW
  if (expectedState == "HIPOT") return pinVal == HIGH;  // NO otwarty → PULLUP → HIGH
  return false;
}

void setup() {
  pinMode(RELAY_PIN, OUTPUT);
  pinMode(CHECK_PIN, INPUT_PULLUP);
  setRelay("HIPOT");   // bezpieczna pozycja na starcie

  Serial.begin(115200);
  Serial.println("READY");
  Serial.println("STATE:HIPOT");
}

void loop() {

  // ── Watchdog ─────────────────────────────────────────────────────────────
  if (watchdogEnabled && (millis() - lastCmdTime > WATCHDOG_TIMEOUT_MS)) {
    if (relayState != "HIPOT") {
      setRelay("HIPOT");
      Serial.println("WATCHDOG:TIMEOUT->HIPOT");
    }
    watchdogEnabled = false;
  }

  // ── Odbiór komend ─────────────────────────────────────────────────────────
  if (Serial.available()) {
    command = Serial.readStringUntil('\n');
    command.trim();

    lastCmdTime     = millis();
    watchdogEnabled = true;

    if (command == "PE") {
      setRelay("PE");
      if (verifyRelay("PE")) {
        Serial.println("OK:PE");
      } else {
        setRelay("HIPOT");           // wróć bezpiecznie jeśli błąd fizyczny
        Serial.println("ERR:RELAY_FAIL:PE");
      }

    } else if (command == "HIPOT") {
      setRelay("HIPOT");
      if (verifyRelay("HIPOT")) {
        Serial.println("OK:HIPOT");
      } else {
        Serial.println("ERR:RELAY_FAIL:HIPOT");
      }

    } else if (command == "STATUS?") {
      Serial.print("STATE:");
      Serial.println(relayState);       // "STATE:HIPOT" lub "STATE:PE"

    } else if (command == "PING") {
      lastCmdTime     = millis();
      watchdogEnabled = true;
      Serial.println("PONG");

    } else if (command == "WATCHDOG:OFF") {
      watchdogEnabled = false;
      Serial.println("OK:WATCHDOG_OFF");

    } else {
      Serial.print("ERR:UNKNOWN:");
      Serial.println(command);
    }
  }
}